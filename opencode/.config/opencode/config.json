{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		"zig-docs": {
			"type": "local",
			"command": [
				"npx",
				"-y",
				"zig-mcp@latest",
				"--doc-source",
				"local"
			],
			"enabled": true
		}
	},
	"provider": {
		"ollama-local": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Ollama Local",
			"options": {
				"baseURL": "http://localhost:11434/v1"
			},
			"models": {
        "gemma4:12b": {
          "name": "Gemma 4 12B",
          "tool_call": true
        }
			}
		}
	}
}
