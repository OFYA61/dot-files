{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		"zig-docs": {
			"type": "local",
			"command": [
				"npx",
				"-y",
				"zig-mcp@latest",
				"--doc-source",
				"local"
			],
			"enabled": false
		}
	},
  "tools": {
    "websearch": true,
    "codesearch": true
  },
	"provider": {
		"ollama-local": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Ollama Local",
			"options": {
				"baseURL": "http://localhost:11434/v1"
			},
      "models": {
        "qwen3.5-claude-4.6-opus-q4:9b-32k": {
          "name": "Qwen3.5 Claude 4.6 Opus Q4 9B (32K)",
          "tool_call": true
        },
        "gemma4:12-32k": {
          "name": "Gemma 4 12B (32k)",
          "tool_call": true
        },
        "gemma4:e4b-32k": {
          "name": "Gemma 4 E4B (32k)",
          "tool_call": true
        }
			}
		}
	}
}
