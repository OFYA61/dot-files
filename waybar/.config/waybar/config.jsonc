{
    "layer": "top",
    "position": "bottom",
    "height": 42,
    "spacing": 4,

    // Layout
    "modules-left": [
        "ext/workspaces"
    ],
    "modules-center": [],
    "modules-right": [
        "network",
        "battery",
        "memory",
        "pulseaudio",
        "group/time"
    ],

    // Module Definitions
    "ext/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by-id": true
    },

    "group/time": {
        "orientation": "horizontal",
        "modules": [
            "clock#calendar",
            "clock"
        ]
    },

    "clock": {
        "format": " {:%H:%M}",
        "tooltip": false
    },

    "clock#calendar": {
        "format": " {:%a, %b %d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "gsimplecal"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "  Muted",
        "format-icons": {
            "headphone": " ",
            "hands-free": " ",
            "headset": " ",
            "phone": " ",
            "portable": " ",
            "car": " ",
            "default": [" ", " ", " "]
        },
        "on-click": "pavucontrol"
    },

    "memory": {
        "interval": 10,
        "format": "    {used:0.1f}G/{total:0.0f}G",
        "tooltip-format": "RAM Usage: {percentage}%\nSwap Used: {swapUsed:0.1f}G"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": [" ", " ", " ", " ", " "]
    },

    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "󰈀  {ipaddr}/{cidr}",
        "format-disconnected": "⚠  Disconnected",
        "tooltip-format-wifi": "Signal Strength: {signalStrength}%",
        "on-click": "alacritty --class floating_window -e nmtui" 
    }
}
